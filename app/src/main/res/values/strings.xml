    <!-- Onboarding and permission -->
    <string name="onboarding_title">Put taps on autopilot</string>
    <string name="onboarding_body">Place targets anywhere on screen and Tap Pilot taps and swipes for you, at exactly the rhythm you choose.</string>
    <string name="onboarding_feature_single">Tap one spot at a steady rhythm</string>
    <string name="onboarding_feature_multi">Chain taps and swipes into sequences</string>
    <string name="onboarding_feature_private">Works offline. Collects nothing.</string>
    <string name="action_get_started">Get started</string>
    <string name="disclosure_title">Before you turn it on</string>
    <string name="disclosure_body">Tap Pilot uses the Android Accessibility Service API to perform the taps and swipes you set up and to show its floating controls. That is the only thing it is used for.</string>
    <string name="disclosure_point_gestures">Performs gestures only where you place targets</string>
    <string name="disclosure_point_no_reading">Never reads your screen or what you type</string>
    <string name="disclosure_point_no_data">Collects and shares no data, and has no internet access</string>
    <string name="action_agree_continue">Agree and continue</string>
    <string name="action_not_now">Not now</string>
    <string name="setup_title">Turn on the service</string>
    <string name="setup_body">Android will ask you to confirm. You can turn it off at any time in the same place.</string>
    <string name="setup_step_open">Tap Open settings below</string>
    <string name="setup_step_find">Find Tap Pilot, often under Downloaded apps or Installed apps</string>
    <string name="setup_step_enable">Turn on Use Tap Pilot and confirm</string>
    <string name="setup_waiting">Waiting for the service…</string>
    <string name="setup_connected">All set</string>
    <string name="setup_restricted_title">Switch greyed out?</string>
    <string name="setup_restricted_body">If you installed Tap Pilot from a file, Android may restrict it. Open App info, tap the ⋮ menu, choose Allow restricted settings, then try again.</string>
    <string name="action_app_info">Open app info</string>

    <!-- Troubleshooting -->
    <string name="ts_service">Accessibility service</string>
    <string name="ts_service_connected">On and connected</string>
    <string name="ts_service_stuck">Turned on, but not responding</string>
    <string name="ts_service_off">Off</string>
    <string name="ts_service_hint">If gestures stop working, turn the service off and on again.</string>
    <string name="ts_battery">Battery optimization</string>
    <string name="ts_battery_optimized">Optimized. Android may pause Tap Pilot in the background.</string>
    <string name="ts_battery_unrestricted">Not optimized</string>
    <string name="ts_battery_action">Battery settings</string>
    <string name="ts_restricted">Switch greyed out</string>
    <string name="ts_oem">Manufacturer power saving</string>
    <string name="ts_oem_body">Some phones stop background services aggressively. In your device’s battery or app settings, allow Tap Pilot to run in the background or autostart.</string>
    <string name="ts_overlap">Taps hitting the controls</string>
    <string name="ts_overlap_body">Keep targets clear of the floating controls. While running they shrink to one button and move aside automatically if a target sits underneath.</string>
    <string name="ts_not_registering">Taps not registering</string>
    <string name="ts_not_registering_body">Some apps ignore extremely short taps. Raise the press duration to 30–50 ms, or make swipes slower.</string>

    <!-- How to use -->
    <string name="howto_title">How to use</string>
    <string name="howto_single_title">Single point</string>
    <string name="howto_single_body">Start single point, drag the target onto the spot you want, then press play. Open settings on the controls to change the rhythm or set a limit.</string>
    <string name="howto_multi_title">Sequences</string>
    <string name="howto_multi_body">Add taps and swipes from the floating controls. Each one gets a number, and they play in that order. Drag targets to move them and tap a target to change its timing. Changes save automatically.</string>
    <string name="howto_controls_title">The floating controls</string>
    <string name="howto_control_play">Start or stop. The ring shows progress toward your limit.</string>
    <string name="howto_control_add_tap">Add a tap target in the middle of the screen.</string>
    <string name="howto_control_add_swipe">Add a swipe. Drag its start and end points.</string>
    <string name="howto_control_remove">Remove the most recent step.</string>
    <string name="howto_control_settings">Timing, limits and natural variation.</string>
    <string name="howto_control_sequences">Switch to another saved sequence.</string>
    <string name="howto_control_close">Hide the controls and targets.</string>
    <string name="howto_control_drag">Drag the controls from any empty spot to move them.</string>

    <!-- Privacy and about -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">Tap Pilot works entirely on your device. It has no internet permission, no ads, no analytics and no accounts.\n\nThe accessibility service is used only to show the floating controls and perform the gestures you set up. It does not read screen content or keystrokes.\n\nYour sequences are stored on this device and only leave it when you export them.</string>
    <string name="about_title">About</string>
    <string name="about_body">Tap Pilot is an auto clicker built with Jetpack Compose and Material 3 Expressive.</string>
</resources>
