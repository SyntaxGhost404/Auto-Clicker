    <string name="app_tagline">Taps and swipes on autopilot</string>

    <!-- Accessibility service (shown in system settings) -->
    <string name="service_label">Tap Pilot</string>
    <string name="service_intro">Turn on to let Tap Pilot tap and swipe for you.</string>
    <string name="service_description">Performs the taps and swipes you set up in Tap Pilot.\n\nThis permission is used only to show the floating controls and to perform gestures at the points you choose. Tap Pilot does not read what is on your screen, does not see what you type and does not collect or share any data. It has no internet access.</string>

